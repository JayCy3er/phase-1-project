# ============================================================
# Studio3D — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# AMD GPU — ROCm settings (required for RX 7900 XTX)
HSA_OVERRIDE_GFX_VERSION=11.0.0
HIP_VISIBLE_DEVICES=0
ROCR_VISIBLE_DEVICES=0

# Redis
REDIS_URL=redis://redis:6379

# Paths (relative to backend directory)
OUTPUT_DIR=./outputs
MODEL_DIR=./models
VOICE_DIR=./voices

# HuggingFace (required for gated model downloads like FLUX.1 Dev)
HF_TOKEN=your_huggingface_token_here

# Model IDs (override to use local paths or alternative models)
FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev
FLUX_LITE_MODEL_ID=stabilityai/stable-diffusion-3.5-medium
TRELLIS_MODEL_ID=microsoft/TRELLIS-image-large
LTX_MODEL_ID=Lightricks/LTX-Video-0.9.7-distilled

# Install tier: full / lite / cloud
INSTALL_TIER=full

# Cloud API keys (only required when INSTALL_TIER=cloud)
FAL_API_KEY=
THREED_AI_STUDIO_KEY=

# Model update manifest URL (host studio3d-models.json here)
MANIFEST_URL=https://yourdomain.com/studio3d-models.json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
